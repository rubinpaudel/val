enum ConfidenceLevel {
  HIGH   @map("high")
  MEDIUM @map("medium")
  LOW    @map("low")

  @@map("confidence_level")
}

enum SourceType {
  WEB_PAGE     @map("web_page")
  APP_STORE    @map("app_store")
  API_RESPONSE @map("api_response")
  REPORT       @map("report")
  NEWS_ARTICLE @map("news_article")

  @@map("source_type")
}

model ResearchResult {
  id              String            @id @default(cuid())
  projectId       String
  researchJobId   String
  resultType      String
  data            Json
  confidence      ConfidenceLevel   @default(MEDIUM)
  confidenceScore Decimal?          @db.Decimal(3, 2)
  sourceCount     Int               @default(0)
  agentType       ResearchAgentType
  agentId         String?
  createdAt       DateTime          @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researchJob ResearchJob    @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  citations   SourceCitation[]

  @@index([projectId])
  @@index([researchJobId])
  @@index([resultType])
  @@index([confidence])
  @@map("research_result")
}

model Source {
  id            String     @id @default(cuid())
  sourceType    SourceType
  title         String?
  url           String?    @db.Text
  rawContent    String?    @db.Text
  extractedData Json?
  author        String?
  publishedAt   DateTime?
  retrievedAt   DateTime   @default(now())
  isVerified    Boolean    @default(false)
  credibility   String?
  discoveredBy  String
  searchQuery   String?
  urlHash       String?    @unique
  contentHash   String?
  screenshotUrl String?
  archivedUrl   String?

  citations SourceCitation[]

  @@index([sourceType])
  @@index([retrievedAt])
  @@index([urlHash])
  @@map("source")
}

model SourceCitation {
  id               String   @id @default(cuid())
  sourceId         String
  researchResultId String
  citedData        Json?
  citedText        String?  @db.Text
  citationPage     Int?
  citationQuote    String?  @db.Text
  relevanceScore   Decimal? @db.Decimal(3, 2)
  createdAt        DateTime @default(now())

  source         Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  researchResult ResearchResult @relation(fields: [researchResultId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([researchResultId])
  @@map("source_citation")
}
