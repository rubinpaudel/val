enum ProjectStatus {
  draft
  structured
  answered
  researching
  researched
  testing
  validated
  shelved
  killed

  @@map("project_status")
}

enum ElementType {
  who
  problem
  solution
  differentiation
  monetization

  @@map("element_type")
}

model Project {
  id           String        @id @default(cuid())
  userId       String

  title        String?
  rawBraindump String        @map("raw_braindump") @db.Text
  status       ProjectStatus @default(draft)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  elements  ProjectElement[]
  questions Question[]
  answers   Answer[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("project")
}

model ProjectElement {
  id        String @id @default(cuid())
  projectId String

  elementType ElementType

  statedValue  String?  @db.Text
  clarityScore Decimal? @db.Decimal(3, 1)

  missingInfo Json @default("[]")

  extractedBy          String   @default("ai")
  extractionConfidence Decimal? @db.Decimal(3, 2)

  version   Int     @default(1)
  isCurrent Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, elementType, version])
  @@index([projectId])
  @@index([elementType])
  @@index([isCurrent])
  @@map("project_element")
}
